# Copie este arquivo para ".env" e preencha com a connection string do seu banco PostgreSQL (ex.: Neon).
# O arquivo .env NÃO vai para o GitHub (está no .gitignore), porque contém a senha do banco.
# Sem DATABASE_URL o servidor usa um banco em memória, que apaga tudo ao reiniciar.
DATABASE_URL=postgresql://usuario:senha@endereco-do-banco/nome-do-banco?sslmode=require
PORT=3000
